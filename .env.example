# Supabase (public — safe for browser)
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-only — NEVER expose to browser or commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection (migrations/CLI only)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# OpenWeatherMap (server-only)
OPENWEATHER_API_KEY=your-openweather-api-key

# App origin used for auth redirects and server actions.
# Local: http://localhost:3000
# Production: https://your-app.vercel.app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Duplicate detection defaults (optional overrides)
DUPLICATE_RADIUS_METERS=150
DUPLICATE_TIME_WINDOW_MINUTES=30
