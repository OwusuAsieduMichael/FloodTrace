# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local — it is gitignored.

# --- Firebase client SDK (safe to expose to the browser) ---
# Report photos are NOT stored here — Cloud Storage for Firebase requires the
# paid Blaze plan. They go to Supabase Storage instead (see below).
NEXT_PUBLIC_FIREBASE_API_KEY=placeholder-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=floodtrace-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=floodtrace-dev
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:placeholder
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-PLACEHOLDER

# Firebase Cloud Messaging web push certificate (VAPID key), used client-side
NEXT_PUBLIC_FIREBASE_VAPID_KEY=placeholder-vapid-key

# --- Firebase Admin SDK (server-only, never expose to the client) ---
FIREBASE_ADMIN_PROJECT_ID=floodtrace-dev
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-placeholder@floodtrace-dev.iam.gserviceaccount.com
# Keep the literal \n escapes; the Firebase Admin SDK expects this format.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----\n"

# --- Supabase Storage (report photos — free tier, no billing required) ---
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-supabase-anon-key

# --- Map tiles (MapLibre GL JS style/tile provider) ---
NEXT_PUBLIC_MAPTILER_API_KEY=placeholder-maptiler-key

# --- Weather context ---
OPENWEATHER_API_KEY=placeholder-openweather-key
